digraph AnalysisData {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.65", fontname="DejaVu Sans", fontsize=15];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fc", color="#7397c5", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [color="#63758a", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  catalog [label="DumpLedger\ncatalog + audit events", fillcolor="#f0f2f5", color="#8a99aa"];
  identity [label="Pinned JobIdentity\ndumpId + SHA-256 + kind + version\nAnalyzer name comes from Config"];
  jobs [label="SQLite\njobs / settled_jobs / cursors", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  content [label="DumpLedger content\nGET with ETag / 304", fillcolor="#f0f2f5", color="#8a99aa"];
  bytes [label="Local bytes cache\nKeyed by expected SHA-256\nSQLite index + filesystem bytes", shape=folder, fillcolor="#eaf6ee", color="#6eac81"];
  verify [label="SHA-256 verification\nDownloaded AND reused cache bytes"];
  request [label="RunRequest\ndump_path · symbol_path\nwork_dir · RunBounds"];
  remote [label="Remote CDB\nSCP-staged dump + script / commands\nScratch directory + symbol cache", fillcolor="#f1ebfc", color="#9c7bc5"];
  symbols [label="DumpLedger /symbols\nSRV*remote-cache*HTTPS-base/symbols", fillcolor="#f0f2f5", color="#8a99aa"];
  provider [label="Selected runner provider\ncdb-ssh: parse CDB transcript\nclaude-cdb: local CLI returns JSON", fillcolor="#f1ebfc", color="#9c7bc5"];
  output [label="RunOutput\noutcome · summary · facts\nBasic exception / frames / symbol status"];
  shrink [label="Lossy verdict assembly\nsummary <= 2,000 characters\nfacts <= 4 KiB; body <= 16 KiB\nWhole facts keys may be dropped", fillcolor="#fff0cf", color="#c68a20", penwidth=2];
  reports [label="SQLite local_reports\nCompacted summary + facts_json\nDelivery flag + pinned identity", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  view [label="Reports API / panel\nPaged summaries only\nDetails repeats summary", fillcolor="#fff4d9", color="#c99c39"];
  delivery [label="Write-back / replay\nSame persisted compact payload"];
  analyses [label="DumpLedger analyses\nIdempotent report identity", fillcolor="#f0f2f5", color="#8a99aa"];
  catalog -> identity [label="available + sealed"];
  identity -> jobs [label="intake / settlement"];
  content -> bytes [label="buffer body, then cache"];
  identity -> bytes [label="cache key"];
  bytes -> verify [label="dump bytes"];
  identity -> verify [label="expected digest"];
  verify -> request [label="verified dump path"];
  request -> remote [label="ToolRunner + SCP / SSH"];
  symbols -> remote [label="symbol material"];
  remote -> provider [label="debugger output"];
  provider -> output [label="structured result"];
  output -> shrink [label="assemble"];
  shrink -> reports [label="store AFTER reduction"];
  reports -> view [label="summary projection"];
  reports -> delivery [label="pending rows; write-back on"];
  delivery -> analyses [label="POST /dumps/:id/analyses"];
}
