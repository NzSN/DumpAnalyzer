digraph AnalysisData {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", fontsize=15];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fc", color="#7397c5", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [color="#63758a", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  identity [label="Pinned identity · source 6a19ea2\nDump ID + SHA-256 + kind + analyzer version\nConfigured name completes canonical / remote identity"];
  content [label="DumpLedger content\nGET with ETag / 304", fillcolor="#f0f2f5", color="#8a99aa"];
  bytes [label="Filesystem bytes + SQLite cache index\nSHA-addressed content\nVerify downloaded and reused bytes", shape=folder, fillcolor="#eaf6ee", color="#6eac81"];
  request [label="RunRequest\nVerified dump path · symbol path\nTemporary work_dir · RunBounds"];
  essential [label="Mandatory offline CDB process\n-y per-run directory; no HTTP store\nTarget · exception · saved context/registers\nInstruction · preliminary stack · initial modules", fillcolor="#f1ebfc", color="#9c7bc5"];
  baseline [label="Owned ReportCapture baseline\nMarked command evidence + capture statuses\nSurvives optional symbol failure"];
  symbols [label="Optional second CDB process\nSymbol reload + detailed modules + final stack\nRemaining time and output budget", fillcolor="#f1ebfc", color="#9c7bc5"];
  ledger_symbols [label="DumpLedger /symbols\nSRV*remote-cache*HTTPS-base/symbols", fillcolor="#f0f2f5", color="#8a99aa"];
  merge [label="Merge available refinement\nFailure → omissions + preliminary evidence retained\nCompleted refinement can upgrade offline Failed"];
  qualify [label="Minidump ModuleList / RSDS expected identities\nRead loaded PDB Info stream GUID / age\nApply symbol quality separately from unwind quality"];
  assess [label="Deterministic evidence-bound assessment\nNarrow immediate read mechanism may be confirmed\nUnderlying origin remains unknown"];
  claude [label="Optional claude-cdb assessment\nEvidence-only local duplex host\nTools disabled / denied · strict empty MCP\nFailure retains deterministic result", fillcolor="#f1ebfc", color="#9c7bc5"];
  output [label="RunOutput + typed ReportCapture\nProvenance · exception/context · stack · symbols\nRootCause · evidence · completeness"];
  canonical [label="CrashReportV2\nStable ID + complete identity + capture\nValidate + canonical JSON + SHA-256 digest\n512 KiB document; bounded retained sections"];
  compact [label="Small legacy compatibility projection\nschemaVersion + reportId + reportDigest\nOnly projection enters 4 KiB facts / 16 KiB envelope", fillcolor="#fff4d9", color="#c99c39"];
  save [label="One SQLite transaction before delivery\nreport_details: canonical JSON / digest / full_delivery\nlocal_reports: compact projection / posted bit\nEligible job handoff", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  detail [label="Lazy local detail + evidence API\nCanonical document independent of projection", fillcolor="#fff4d9", color="#c99c39"];
  delivery [label="Full-report publication + durable replay\nUnsupported rich route → compact summary\nSummaryOnly remains eligible for full promotion"];
  analyses [label="DumpLedger analyses\nFull canonical document OR bound compact summary", fillcolor="#f0f2f5", color="#8a99aa"];
  limits [label="Retained evidence is bounded; no durable full transcript\nLocal SSH timeout does not prove remote child termination\nRemote scratch cleanup is best effort\nNo implemented confirmed-origin rule", shape=note, fillcolor="#f0f2f5", color="#8a99aa"];
  identity -> bytes [label="Expected hash"];
  content -> bytes [label="Buffer then cache"];
  bytes -> request;
  request -> essential [label="SCP / SSH"];
  essential -> baseline [label="Parse owned evidence first"];
  baseline -> symbols [label="Attempt optional refinement"];
  ledger_symbols -> symbols [label="Symbols only in this phase"];
  baseline -> merge [label="Retained essentials"];
  symbols -> merge [label="Available refinements / failure status"];
  merge -> qualify -> assess;
  assess -> output [label="cdb-ssh"];
  assess -> claude [label="claude-cdb", style=dashed];
  claude -> output [label="Validated proposal or fallback", style=dashed];
  output -> canonical;
  canonical -> compact [label="Derive bound projection"];
  canonical -> save [label="Canonical preserved"];
  compact -> save [label="Atomic with canonical"];
  save -> detail;
  save -> delivery [label="Write-back enabled"];
  delivery -> analyses;
  output -> limits [style=dotted, arrowhead=none, constraint=false];
}
