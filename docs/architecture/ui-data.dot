digraph UiData {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.6", fontname="DejaVu Sans", fontsize=15];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fc", color="#7397c5", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [color="#63758a", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  ledger [label="DumpLedger available catalog + labels\nCustomer names / representative case detail", fillcolor="#f0f2f5", color="#8a99aa"];
  cache [label="DumpsExplorer snapshot\n30 s shared cache; serialized refresh\nFull catalog remains in server memory"];
  browse [label="GET /api/dumps/browse\nSearch + scope + one hierarchy level\nDefault 25 rows; maximum 100"];
  db [label="SQLite · source 6a19ea2\njobs / settled_jobs / local_reports\nreport_details: canonical JSON + delivery", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  manual [label="Ephemeral active manual registry\nClears on return / error / cancellation"];
  queue [label="GET /api/jobs\nActive persistent + manual rows\nExcludes Discovered and terminal rows"];
  reports [label="GET /api/reports\nSQL counts / filters / stable page\nNo facts or canonical JSON read\nSummary + ID + schema + fullDelivery"];
  detail [label="GET /api/reports/:reportId\nRich: saved canonical document + digest + delivery\nLegacy: explicit missing-detail warning"];
  evidence [label="GET /api/reports/:reportId/evidence/:evidenceId\nIndividual saved evidence projection\nAvailable API; dashboard uses detail's evidence array"];
  status [label="GET /api/status\nQueue totals + report counts + cursor"];
  subgraph cluster_browser {
    label="Browser · one selected view · anonymous reads"; color="#e3c77b"; style=rounded;
    dumps_panel [label="Dumps panel\nCustomer → case → dump pages\n25 rows; visible refresh 15 s", fillcolor="#fff4d9", color="#c99c39"];
    queue_panel [label="Queue panel\nActive work only\nVisible refresh 5 s", fillcolor="#fff4d9", color="#c99c39"];
    reports_panel [label="Reports list\n25 rows + filters + summary + delivery\nVisible refresh 15 s", fillcolor="#fff4d9", color="#c99c39"];
    detail_panel [label="Selected report · lazy GET on navigation\nAbort/version guard; cache at most 3 documents\nNo list polling or evidence background refresh\nBack preserves list context; JSON download", fillcolor="#fff4d9", color="#c99c39"];
    sections [label="Rich detail sections + collapsed evidence text\nException / context · native stack · symbol identities\nMechanism / origin · missing evidence · provenance\nCitation buttons open retained evidence section", fillcolor="#fff4d9", color="#c99c39"];
    chrome [label="Status / navigation / Settings\nVisible status refresh 5 s\nSearch debounce 250 ms; URL hash state", fillcolor="#fff4d9", color="#c99c39"];
  }
  ledger -> cache [label="Paged upstream fetch"];
  cache -> browse [label="Page of groups OR dumps"];
  db -> browse [label="Phase overlay on returned dumps"];
  manual -> browse [label="Active overlay"];
  db -> queue [label="Active SQL rows"];
  manual -> queue [label="Merge / deduplicate"];
  db -> reports [label="List projection only"];
  db -> detail [label="Read selected report on demand"];
  detail -> evidence [label="Project saved section"];
  db -> status [label="Counts / cursor"];
  queue -> status [label="Active totals"];
  browse -> dumps_panel [label="Bounded JSON page"];
  queue -> queue_panel;
  reports -> reports_panel [label="Bounded JSON page"];
  reports_panel -> detail_panel [label="Select reportId"];
  detail -> detail_panel [label="One lazy detail response"];
  detail_panel -> sections [label="Includes bounded evidence array"];
  status -> chrome;
}
