digraph JobControl {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.35", ranksep="0.55", fontname="DejaVu Sans", fontsize=15];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fc", color="#7397c5", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [color="#63758a", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  subgraph cluster_auto {
    label="Scheduled entry · persistent phases · source 6a19ea2"; color="#b5c9e2"; style=rounded;
    discovered [label="Discovered\nInventory candidate; hidden from Jobs", fillcolor="#f0f2f5", color="#8a99aa"];
    claimed [label="Claimed\nAtomic claim for configured version"];
    fetch [label="Fetching → Staged\nFetch/cache → verify pinned SHA-256"];
    analyze [label="Analyzing\nToolRunner returns owned typed capture"];
    discovered -> claimed -> fetch -> analyze;
  }
  subgraph cluster_manual {
    label="Manual entry · ephemeral active registry"; color="#e3c77b"; style=rounded;
    action [label="POST analyze / case / customer\nScope: sequential, at most 64 dumps", fillcolor="#fff4d9", color="#c99c39"];
    gate [label="Require available + sealed dump\nPin identity + configured version"];
    existing [label="Existing local report?", shape=diamond];
    reuse [label="Rich + matching analyzer name\nReturn saved projection; no execution", fillcolor="#eaf6ee", color="#6eac81"];
    conflict [label="Legacy identity or different analyzer name\nRequire distinct version / report conflict", fillcolor="#fff0cf", color="#c68a20"];
    attempt [label="Register active manual row as Claimed\nAgent::attempt: fetch → verify → ToolRunner\nAt most two charged transient failures"];
    action -> gate -> existing;
    existing -> reuse [label="Rich"];
    existing -> conflict [label="Legacy / wrong attribution"];
    existing -> attempt [label="No report"];
  }
  prepare [label="Build validated CrashReportV2 + canonical digest\nDerive digest-bound compact projection\nCanonical evidence bypasses legacy shrinker"];
  save [label="One SQLite transaction\nreport_details: canonical JSON + digest + full-delivery state\nlocal_reports: compact projection\nScheduled → Reporting; manual → eligible idle handoff", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  mode [label="write-back enabled?", shape=diamond];
  entry [label="entry point?", shape=diamond];
  pending [label="Manual: return stored projection\nClear active guard\nIndependent delivery sweep publishes"];
  post [label="Scheduled: publish now\nFull report; unsupported route → compact fallback"];
  retry [label="Durable replay / full promotion every 60 s\nPendingFull and SummaryOnly survive settlement"];
  archive [label="Done / Failed / Dropped → settled_jobs\nAtomic removal from physical jobs\nEvidence and delivery state remain", shape=cylinder, fillcolor="#eaf6ee", color="#6eac81"];
  analyze -> prepare;
  attempt -> prepare;
  prepare -> save -> mode;
  mode -> archive [label="off: eligible row Done locally"];
  mode -> entry [label="on"];
  entry -> post [label="Scheduled"];
  entry -> pending [label="Manual"];
  pending -> retry;
  post -> archive [label="Accepted / local fallback / terminal rejection"];
  post -> retry [label="Transient / route absent / summary accepted"];
  retry -> post [label="Persisted document", constraint=false];
  fetch -> archive [label="Purged / exhausted failures", style=dashed, constraint=false];
  analyze -> archive [label="Terminal runner error", style=dashed, constraint=false];
  note [label="Scheduled concurrency 1 is not a global runner limit\nManual requests may overlap scheduler and each other\nManual handoff preserves running / archived identities\nDone settlement ≠ completed outcome ≠ full delivery", shape=note, fillcolor="#f0f2f5", color="#8a99aa"];
  archive -> note [style=dotted, arrowhead=none];
}
