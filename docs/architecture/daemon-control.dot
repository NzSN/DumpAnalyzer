digraph DaemonControl {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.35", ranksep="0.5", fontname="DejaVu Sans", fontsize=15];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fc", color="#7397c5", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [color="#63758a", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  start [label="main · source 6a19ea2\nParse Config · select ToolRunner · install signal watcher", shape=oval];
  open [label="Acquire state-directory lock → open / migrate SQLite\nResolve environment token or persisted token"];
  recover [label="Fetching / Staged / Analyzing → Claimed\nPreserve charged attempts"];
  retire [label="Drop active non-Reporting jobs from older versions\nRetain report history and pinned Reporting delivery"];
  reconcile [label="Reconcile Reporting + pending report delivery\nWrite-back off: settle locally\nSweep orphaned run-* workspaces"];
  scan [label="Initial catalog scan with retry\nAlso runs with scheduler=off\nHTTP has not started yet"];
  fork [label="Start optional HTTP task + three supervised futures\nShared store, boot configuration and ToolRunner", fillcolor="#fff4d9", color="#c99c39"];
  start -> open -> recover -> retire -> reconcile -> scan -> fork;
  subgraph cluster_feed {
    label="Feed follower"; color="#b5c9e2"; style=rounded;
    feed [label="Read lifecycle audit page\nFrom durable cursor"];
    apply [label="Recheck eligible dumps\nInsert Discovered / archive purged jobs\nThen commit page cursor"];
    feed -> apply;
    apply -> feed [label="Poll / transient backoff\nInterrupted page replays"];
  }
  subgraph cluster_scheduler {
    label="Automatic scheduler"; color="#b5c9e2"; style=rounded;
    enabled [label="scheduler enabled?", shape=diamond];
    claim [label="Resume current-version Claimed first\nThen claim oldest current-version Discovered"];
    run [label="Agent::run_job\nAwait this job before next claim"];
    auto_idle [label="Wait for shutdown\nNo automatic claims", fillcolor="#f0f2f5", color="#8a99aa"];
    enabled -> claim [label="yes"];
    enabled -> auto_idle [label="off"];
    claim -> run [label="Job available"];
    run -> claim [label="Next job / backoff"];
  }
  subgraph cluster_delivery {
    label="Independent report delivery"; color="#b5c9e2"; style=rounded;
    wb [label="write-back enabled?", shape=diamond];
    replay [label="Every 60 s: replay compact-pending rows\nAlso promote pendingFull / summaryOnly documents\nSettle late Reporting rows"];
    local [label="Wait for shutdown\nKeep reports local", fillcolor="#eaf6ee", color="#6eac81"];
    wb -> replay [label="yes"];
    wb -> local [label="off"];
    replay -> replay [label="Independent of analysis"];
  }
  subgraph cluster_http {
    label="Optional HTTP task"; color="#e3c77b"; style=rounded;
    listen [label="Bind configured address\nDefault 127.0.0.1:4180", fillcolor="#fff4d9", color="#c99c39"];
    request [label="Anonymous GET: lists / lazy detail / evidence\nPOST: manual / scope / rescan / token\nTask per connection; serving failure is logged", fillcolor="#fff4d9", color="#c99c39"];
    listen -> request;
  }
  fork -> feed;
  fork -> enabled;
  fork -> wb;
  fork -> listen [label="If HTTP enabled", style=dashed];
  signal [label="SIGINT / SIGTERM → cancellation\nScheduled in-flight job drains; HTTP connections are not joined\nFatal supervised-loop error can terminate the daemon", shape=note, fillcolor="#f0f2f5", color="#8a99aa"];
  fork -> signal [style=dotted, arrowhead=none, constraint=false];
}
