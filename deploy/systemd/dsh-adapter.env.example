# Install as ~/.config/dump-analyzer/dsh-adapter.env with mode 0600 only
# after supplying the token. systemd EnvironmentFile values do not expand
# ~, $HOME, or %h.
DSH_ANALYZER_ADAPTER_TOKEN='replace-with-adapter-bearer-token'
# Optional service-side model key fallback (normally the daemon forwards the
# key per session; keep this file mode 0600 either way):
# OPENCODE_API_KEY='replace-with-model-gateway-key'
# DSH_ANALYZER_MESSAGE_TIMEOUT_MS=170000
# DSH_ANALYZER_SKIP_BOOT_CHECK=
